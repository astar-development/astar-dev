{
  "enabledPlugins": {
    "serena@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "graphify update \"$CLAUDE_PROJECT_DIR\""
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/code-coverage.sh\""
          }
        ]
      }
    ]
  }
}