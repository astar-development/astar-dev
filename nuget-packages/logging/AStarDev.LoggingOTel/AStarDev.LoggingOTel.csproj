<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.8.3" />
      <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
      <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
      <PackageReference Include="OpenTelemetry" Version="1.18.0" />
      <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.18.0" />
      <PackageReference Include="System.Reactive" Version="7.0.0" />
    </ItemGroup>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <PackageTags>opentelemetry;extensions;astar;astardevelopment</PackageTags>
        <Title>AStar Dev Logging OpenTelemetry</Title>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
        <Description>An OpenTelemetry logging configuration for AStar Dev applications.</Description>
        <PackageProjectUrl>https://github.com/astar-development/astar-dev-mono/tree/main/packages/core</PackageProjectUrl>
        <DocumentationFile>$(AssemblyName).xml</DocumentationFile>
        <PackageReleaseNotes>Initial release.</PackageReleaseNotes>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <NoWarn>$(NoWarn);CA1724;CA1062</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
