  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Fab4Kids.Web/Fab4Kids.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Catalogue/Fixtures/Data/pdfs.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
